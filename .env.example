APP_NAME=HexaScore
APP_ENV=development
APP_KEY=
# Former APP_KEY values, comma-separated: they still decrypt after a rotation.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
PORT=3000

# Local stack from docker-compose.yml (127.0.0.1 only, dev-only credentials).
DATABASE_URL=postgres://hexascore:hexascore@127.0.0.1:5433/hexascore?sslmode=disable
TEST_DATABASE_URL=postgres://hexascore:hexascore@127.0.0.1:5433/postgres?sslmode=disable

# S3 driver (https://vukem.dev/docs/digging-deeper/storage). Fill with the RUSTFS_* values
# of docker-compose.yml when running locally; never put production keys here.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=true
S3_INSECURE_HTTP=true
# Public origin of the cover bucket or CDN (https); empty serves covers from the app origin under /covers
COVERS_BASE_URL=
# data_sources codes whose fields reach paid API customers, comma-separated; empty = wikidata,wikipedia,openlibrary,hexascore,community
# (Open Library: docs/legal/open-library.md)
CATALOG_API_SOURCES=
# backup:run (SDD 11 §7.3): 32 random bytes, base64, separate from APP_KEY. Local only: openssl rand -base64 32
BACKUP_KEY=
# backup:offsite mails the 7-day link to the monthly dump to these comma-separated addresses (owner only)
ADMIN_EMAILS=
# Admin panel (SDD 13 §7.5): comma-separated CIDRs or addresses checked against the client IP
# (TRUSTED_PROXIES decides which IP that is). Empty means no allowlist.
ADMIN_IP_ALLOWLIST=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
# Verified App Links (SDD 10 §7.6): /.well-known/assetlinks.json. Fingerprints come from
# `eas credentials -p android` (upload key, then the Play signing key), comma-separated.
ANDROID_PACKAGE=app.hexascore
ANDROID_CERT_SHA256=

# Scheduler expressions run in this zone (nightly recompute at 04:00 Sao Paulo, SDD 02 section 6).
SCHEDULE_TIMEZONE=America/Sao_Paulo
# Scheduler, queue worker and HTTP share one process (SDD 11 §6.3); false drops the scheduler readiness check.
SCHEDULE_IN_SERVE=true
QUEUE_NAMES=default,ingest
QUEUE_CONCURRENCY=3
# Running-job cap per queue; unset keeps ingest=2 (NFR-06-2, config.DefaultQueueLimits). Set it in the process env, not .env.
# QUEUE_LIMITS=ingest=2
# Budget for draining requests, jobs and tasks; the SSR child stops after it. Railway draining is 35 s.
SHUTDOWN_TIMEOUT=30s
# Memory caps for the Go runtime and the supervised Node SSR child (it inherits NODE_OPTIONS).
GOMEMLIMIT=900MiB
NODE_OPTIONS=--max-old-space-size=384

# Needed by /profile sessions and RevokeOthers; set it on Railway too.
SESSION_DRIVER=database
# Records a truncated IP (/24 or /48) and the user agent on each logged-in session. Retention clears both at 30 days.
SESSION_RECORD_CLIENT=true

# Mail addresses (Q-A17): noreply@ sends every automatic message, support@ receives and answers user email.
MAIL_FROM=HexaScore <noreply@hexascore.app>
# Reply-To of automatic mail.
MAIL_SUPPORT_ADDRESS=support@hexascore.app
# Contact form recipient; defaults to MAIL_SUPPORT_ADDRESS.
CONTACT_INBOX=
# Private local disk for LGPD data export ZIPs (SDD 14 §7.4); served only through signed 24 h links.
EXPORTS_DIR=storage/exports

# OpenAPI document scope: only the paid read API (SDD 05 §6.5); the whole router has duplicate operationIds.
OPENAPI_PREFIX=/api/v1

# Public API host; /v1/* on it maps to /api/v1/*
API_HOST=api.hexascore.app

# Stripe (vukem install:billing). A restricted key (rk_...) with only the billing permissions.
STRIPE_KEY=
# stripe listen --forward-to localhost:3000/stripe/webhook prints whsec_...
STRIPE_WEBHOOK_SECRET=
# Recurring price ids (price_...) of the plans in config/billing.go; each price has BRL/USD/EUR currency_options.
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Ingestion (SDD 06). Every job is off until FLAG_INGEST_ENABLED and its FLAG_INGEST_<SOURCE> are true.
INGEST_CONTACT_URL=https://hexascore.app/bot
FLAG_INGEST_ENABLED=false
FLAG_INGEST_WIKIDATA=false
FLAG_INGEST_WIKIPEDIA=false
FLAG_INGEST_TMDB=false
THEMOVIEDATABASE_API_READ_ACCESS_TOKEN=
FLAG_INGEST_OPENLIBRARY=false
# IGDB authenticates with a Twitch app (client credentials grant); the owner sets both values.
FLAG_INGEST_IGDB=false
IGDB_TWITCH_CLIENT_ID=
IGDB_TWITCH_CLIENT_SECRET=
FLAG_INGEST_STEAM=false
FLAG_INGEST_GOG=false

# Social layer (SDD 14 §12): follows and the feed stay 404 until this is true (Q-A5 open).
FLAG_SOCIAL=false

# Analytics and search verification (vukem analytics; docs/analytics-acess.md). Every one is optional: unset = off.
# Umami is cookieless and always on when set; GA4 loads only after the cookie banner grants consent (ADR 0023).
UMAMI_WEBSITE_ID=
UMAMI_DOMAINS=
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Bing Webmaster API (vukem bingwmt): secret, server side only.
BING_WEBMASTER_API_KEY=
# IndexNow (vukem indexnow): the key is published at /{key}.txt; catalogue writes queue indexnow.Job.
INDEXNOW_KEY=
# true on staging (APP_ENV=production there): robots.txt disallows all and every response carries X-Robots-Tag noindex.
SEO_NOINDEX=

# Cloudflare Turnstile (vukem challenge): protects sign-up, login and contact, and the scrape-guard step-up.
# Off while both are empty. Local/dev may use Cloudflare's published test keys (always pass):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Expected hostname in the siteverify answer (production: hexascore.app).
TURNSTILE_HOSTNAME=
