APP_NAME=hexascore
APP_ENV=development
APP_KEY=
# Former APP_KEY values, comma-separated: they still decrypt after a rotation.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
PORT=3000

# Local stack from docker-compose.yml (127.0.0.1 only, dev-only credentials).
DATABASE_URL=postgres://hexascore:hexascore@127.0.0.1:5433/hexascore?sslmode=disable
TEST_DATABASE_URL=postgres://hexascore:hexascore@127.0.0.1:5433/postgres?sslmode=disable

# S3 driver (https://vukem.dev/docs/digging-deeper/storage). Fill with the RUSTFS_* values
# of docker-compose.yml when running locally; never put production keys here.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=true
S3_INSECURE_HTTP=true
# backup:run (SDD 11 §7.3): 32 random bytes, base64, separate from APP_KEY. Local only: openssl rand -base64 32
BACKUP_KEY=
# Admin panel (SDD 13 §7.5): comma-separated CIDRs or addresses checked against the client IP
# (TRUSTED_PROXIES decides which IP that is). Empty means no allowlist.
ADMIN_IP_ALLOWLIST=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=

# Scheduler expressions run in this zone (nightly recompute at 04:00 Sao Paulo, SDD 02 section 6).
SCHEDULE_TIMEZONE=America/Sao_Paulo
# Scheduler, queue worker and HTTP share one process (SDD 11 §6.3); false drops the scheduler readiness check.
SCHEDULE_IN_SERVE=true
QUEUE_NAMES=default,ingest
QUEUE_CONCURRENCY=3
# Budget for draining requests, jobs and tasks; the SSR child stops after it. Railway draining is 35 s.
SHUTDOWN_TIMEOUT=30s
# Memory caps for the Go runtime and the supervised Node SSR child (it inherits NODE_OPTIONS).
GOMEMLIMIT=900MiB
NODE_OPTIONS=--max-old-space-size=384

# Needed by /profile sessions and RevokeOthers; set it on Railway too.
SESSION_DRIVER=database
# Records a truncated IP (/24 or /48) and the user agent on each logged-in session. Retention clears both at 30 days.
SESSION_RECORD_CLIENT=true

# Contact form recipient; unset stores messages without mailing.
CONTACT_INBOX=
# Private local disk for LGPD data export ZIPs (SDD 14 §7.4); served only through signed 24 h links.
EXPORTS_DIR=storage/exports

# OpenAPI document scope: only the paid read API (SDD 05 §6.5); the whole router has duplicate operationIds.
OPENAPI_PREFIX=/api/v1

# Public API host; /v1/* on it maps to /api/v1/*
API_HOST=api.hexascore.app

# Stripe (vukem install:billing). A restricted key (rk_...) with only the billing permissions.
STRIPE_KEY=
# stripe listen --forward-to localhost:3000/stripe/webhook prints whsec_...
STRIPE_WEBHOOK_SECRET=
# Recurring price ids (price_...) of the plans in config/billing.go; each price has BRL/USD/EUR currency_options.
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
