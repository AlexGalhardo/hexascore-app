# Copy to apps/web/.env.local (bun run dev) — never commit real values.

NEXT_PUBLIC_APP_NAME="Hexascore"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Postgres. Local Docker (setups/): postgres://hexascore:hexascore@localhost:5432/hexascore
# Empty DATABASE_URL = in-process PGlite at apps/web/.pglite (no Docker needed).
DATABASE_URL=""

# Better Auth — generate with: bunx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Upstash Redis (API rate limit + quota). Local Docker: http://localhost:8079 with token "local-dev-token"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Hexascore <no-reply@example.com>"
# Optional: /contact messages are also emailed here (always stored in contact_messages)
CONTACT_INBOX=""

# Stripe (test mode keys locally)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AbacatePay (PIX) — dev key in sandbox
ABACATEPAY_API_KEY=""
ABACATEPAY_WEBHOOK_SECRET=""

# Vercel Blob (covers, avatars)
BLOB_READ_WRITE_TOKEN=""

# Cron + ingestion revalidation: openssl rand -hex 32
CRON_SECRET=""

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
