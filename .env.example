APP_NAME=hexascore
APP_ENV=development
APP_KEY=
# Former APP_KEY values, comma-separated: they still decrypt after a rotation.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
PORT=3000

# Local stack from docker-compose.yml (127.0.0.1 only, dev-only credentials).
DATABASE_URL=postgres://hexascore:hexascore@127.0.0.1:5433/hexascore?sslmode=disable
TEST_DATABASE_URL=postgres://hexascore:hexascore@127.0.0.1:5433/postgres?sslmode=disable

# S3 driver (https://vukem.dev/docs/digging-deeper/storage). Fill with the RUSTFS_* values
# of docker-compose.yml when running locally; never put production keys here.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=true
S3_INSECURE_HTTP=true
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=

# Scheduler expressions run in this zone (nightly recompute at 04:00 Sao Paulo, SDD 02 section 6).
SCHEDULE_TIMEZONE=America/Sao_Paulo

# Needed by /profile sessions and RevokeOthers; set it on Railway too.
SESSION_DRIVER=database

# Contact form recipient; unset stores messages without mailing.
CONTACT_INBOX=
