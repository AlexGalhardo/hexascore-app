{
  // markdownlint-cli2 configuration (D-37). Long lines are allowed: tables and citations are long by nature.
  "default": true,
  "MD013": false,
  "MD033": { "allowed_elements": ["br", "sub", "sup", "div", "h1", "a", "img"] },
  "MD024": { "siblings_only": true },
  "MD041": false,
  "MD010": { "code_blocks": false },
  // docs/web-research.md uses numeric citation markers whose definitions
  // are missing (questions-to-dev.md Q-D-003); re-enable after the owner restores them.
  "MD052": false
}
