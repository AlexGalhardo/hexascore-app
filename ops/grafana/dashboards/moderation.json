{
  "title": "Moderation",
  "uid": "hexascore-moderation",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "hexascore",
    "community"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue size",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(suggest_queue_size)",
          "legendFormat": "open"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Oldest open",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(suggest_queue_oldest_seconds)",
          "legendFormat": "oldest"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Open age p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(suggest_queue_age_p50_seconds)",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "max(suggest_queue_age_p95_seconds)",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Decisions per day",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision) (increase(suggest_decisions_total[1d]))",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "SLA breaches per day (decided after 24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision) (increase(suggest_sla_breaches_total[1d]))",
          "legendFormat": "{{decision}}"
        }
      ]
    }
  ]
}
