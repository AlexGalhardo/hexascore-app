{
  "packageManager": "bun@1.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:ssr": "vite build --ssr resources/js/ssr.tsx",
    "build:docs": "bun scripts/build-docs.ts",
    "lint": "biome ci resources/js packages qa/e2e",
    "test": "vitest run",
    "e2e": "playwright test -c qa/e2e/playwright.config.ts",
    "openapi:check": "bash scripts/openapi-check.sh",
    "openapi:lint": "redocly lint",
    "sdk:generate": "cd sdks/ts && bun run sdk:generate",
    "sdk:generate:python": "uvx --from openapi-python-client==0.29.1 openapi-python-client generate --path openapi/api-v1.json --config sdks/python/config.yml --output-path sdks/python/hexascore --meta none --overwrite && bun -e \"await Bun.write('sdks/python/hexascore/py.typed', '')\""
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@inertiajs/react": "3.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@inertiajs/vite": "3.9.1",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.72.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
