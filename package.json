{
  "name": "hexascore",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "sdks/ts"
  ],
  "scripts": {
    "dev": "bun --filter web dev",
    "build": "bun --filter web build",
    "start": "bun --filter web start",
    "typecheck": "bun --filter web typecheck",
    "test": "bun --filter web test",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "db:generate": "bun --filter web db:generate",
    "db:migrate": "bun --filter web db:migrate",
    "db:seed": "bun --filter web db:seed",
    "openapi": "bun --filter web openapi",
    "openapi:check": "bun --filter web openapi:check",
    "sdk:generate": "bun --filter @hexascore/sdk sdk:generate",
    "sdk:generate:python": "uvx --from openapi-python-client==0.29.1 openapi-python-client generate --path apps/web/public/openapi.json --config sdks/python/config.yml --output-path sdks/python/hexascore --meta uv --overwrite",
    "admin:grant": "bun --cwd apps/web scripts/admin-grant.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
