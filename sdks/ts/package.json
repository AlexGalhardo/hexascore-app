{
  "name": "@hexascore/sdk",
  "version": "0.1.0",
  "description": "Typed client for the Hexascore API (community scores for games, movies, TV series and books).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "keywords": ["hexascore", "api", "sdk", "games", "movies", "series", "books", "ratings"],
  "homepage": "https://hexascore.app/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexGalhardo/hexascore-app.git",
    "directory": "sdks/ts"
  },
  "bugs": { "url": "https://github.com/AlexGalhardo/hexascore-app/issues" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "sdk:generate": "openapi-ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
