    "wikipedia:en": {
      "qid": "Q24154",
      "lang": "en",
      "title": "Van Diemen's Land (film)",
      "extract": "Van Diemen's Land is a 2009 Australian thriller, directed by Jonathan auf der Heide. Set in 1822 in colonial Tasmania it follows the story of the infamous Irish convict, Alexander Pearce, played by Oscar Redding and narrates the events of his escape from Sarah Island with seven other convicts. The voice-over and some of the dialogue is in Irish.",
