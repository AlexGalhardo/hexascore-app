    },
    "wikipedia:pt": {
      "qid": "Q27130",
      "lang": "pt",
      "title": "The Screaming Shadow",
      "extract": "The Screaming Shadow é um seriado estadunidense de 1920, no gênero ação, dirigido por Ben F. Wilson e Duke Worne, em 15 capítulos, estrelado por Ben F. Wilson e Neva Gerber. Foi produzido pela Hallmark Pictures Corporation, e veiculou nos cinemas estadunidenses entre 26 de janeiro e 22 de maio de 1920.\nEste seriado é considerado perdido.",
      "url": "https://pt.wikipedia.org/wiki/The_Screaming_Shadow"
    }
