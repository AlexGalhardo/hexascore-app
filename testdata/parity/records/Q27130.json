    "wikipedia:en": {
      "qid": "Q27130",
      "lang": "en",
      "title": "The Screaming Shadow",
      "extract": "The Screaming Shadow is a 1920 American 15-chapter silent film serial directed by Ben F. Wilson and Duke Worne. The film is considered to be lost.",
