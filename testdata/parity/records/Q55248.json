    "wikipedia:en": {
      "qid": "Q55248",
      "lang": "en",
      "title": "Star Wars Trilogy Arcade",
      "extract": "Star Wars Trilogy Arcade is a 1998 rail shooter video game developed by Sega AM Annex and published by Sega for arcades. It is based on the original trilogy of Star Wars films, and was released shortly after those films' special editions. Accompanied by the Star Wars Trilogy pinball game, it is the second in Sega's Star Wars Arcade series, preceded by 1993's Star Wars Arcade and followed by 2000's Star Wars Racer Arcade.",
      "url": "https://en.wikipedia.org/wiki/Star_Wars_Trilogy_Arcade"
    },
    "wikipedia:es": {
      "qid": "Q55248",
      "lang": "es",
      "title": "Star Wars Trilogy Arcade",
      "extract": "Star Wars Trilogy Arcade es un juego de arcade lanzado en 1998. Es un juego de disparos en 3D basado en la trilogía original de las películas de Star Wars y fue lanzado junto con las ediciones especiales de estas películas. Acompañado por el juego de pinball Star Wars Trilogy, es el segundo en la serie Star Wars Arcade de Sega; está precedido por Star Wars Arcade de 1993 y seguido por Star Wars: Racer Arcade de 2000.",
      "url": "https://es.wikipedia.org/wiki/Star_Wars_Trilogy_Arcade"
    }
