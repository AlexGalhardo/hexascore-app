{
	"$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["../../biome.json"],
	"files": {
		"includes": ["**", "!android", "!ios", "!node_modules", "!.expo", "!coverage", "!dist"]
	},
	"plugins": [
		{
			"path": "./no-fetch-outside-api.grit",
			"includes": ["src/**", "!src/api/**"]
		}
	],
	"overrides": [
		{
			"includes": ["global.css"],
			"linter": {
				"rules": {
					"suspicious": {
						"noUnknownAtRules": "off"
					}
				}
			}
		}
	]
}
