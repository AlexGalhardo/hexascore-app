{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"jsxImportSource": "nativewind",
		"resolveJsonModule": true,
		"types": ["jest", "node"]
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
	"exclude": ["node_modules", "android", "ios", "coverage", "dist"]
}
