{
	"name": "@hexascore/mobile",
	"version": "1.0.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"android:dev": "node scripts/android-dev.cjs",
		"lint": "biome ci .",
		"typecheck": "tsc --noEmit",
		"test": "bun scripts/run-jest.cjs",
		"catalogues": "bun scripts/copy-catalogues.ts",
		"bundle:check": "rm -rf .bundle-check && expo export:embed --platform android --dev false --entry-file node_modules/expo-router/entry.js --bundle-output .bundle-check/index.android.bundle --assets-dest .bundle-check && bun scripts/check-bundle.cjs .bundle-check/index.android.bundle"
	},
	"dependencies": {
		"@expo/metro-runtime": "58.0.17",
		"@expo/ui": "58.0.27",
		"@expo/vector-icons": "15.1.1",
		"@tanstack/react-query": "5.107.1",
		"@tanstack/react-query-persist-client": "5.107.1",
		"expo": "58.0.23",
		"expo-auth-session": "58.0.17",
		"expo-constants": "58.0.15",
		"expo-crypto": "58.0.7",
		"expo-device": "58.0.5",
		"expo-font": "58.0.11",
		"expo-haptics": "58.0.7",
		"expo-image": "58.0.18",
		"expo-linking": "58.0.16",
		"expo-router": "58.0.30",
		"expo-secure-store": "58.0.2",
		"expo-sqlite": "58.0.15",
		"nativewind": "4.2.7",
		"react": "19.3.1",
		"react-native": "0.88.1",
		"react-native-gesture-handler": "3.5.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "5.11.1",
		"react-native-screens": "4.30.1",
		"react-native-worklets": "0.13.1"
	},
	"devDependencies": {
		"@babel/core": "8.1.0",
		"@testing-library/react-native": "14.1.0",
		"@types/jest": "30.0.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"babel-preset-expo": "58.0.24",
		"jest": "30.5.2",
		"jest-expo": "58.0.14",
		"react-test-renderer": "19.3.1",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2"
	}
