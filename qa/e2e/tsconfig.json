{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["dom", "ES2023"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "test-results", "playwright-report"]
}
