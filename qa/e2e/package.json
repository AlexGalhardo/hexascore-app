{
  "name": "e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop-light --project=desktop-dark",
    "test:mobile": "playwright test --project=mobile-light --project=mobile-dark",
    "report": "playwright show-report",
    "install-browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "postgres": "3.4.9",
    "typescript": "7.0.2"
  }
}
