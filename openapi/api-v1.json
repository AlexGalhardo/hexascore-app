  "components": {
    "schemas": {
      "ChangeJSON": {
        "properties": {
          "action": {
            "enum": [
              "created",
              "updated",
              "deleted"
            ],
            "minLength": 1,
            "type": "string"
          },
          "changedAt": {
            "minLength": 1,
            "type": "string"
          },
          "fields": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "itemId": {
            "minLength": 1,
            "type": "string"
          },
          "itemType": {
            "enum": [
              "games",
              "movies",
              "series",
              "books"
            ],
            "minLength": 1,
            "type": "string"
          },
          "mergedInto": {
            "type": [
              "string",
              "null"
            ]
