{
	"ci": {
		"collect": {
			"url": [
				"http://127.0.0.1:3000/",
				"http://127.0.0.1:3000/games",
				"http://127.0.0.1:3000/games/adipiscing-consectetur",
				"http://127.0.0.1:3000/books/consectetur-2004",
				"http://127.0.0.1:3000/people/ana-oliveira"
			],
			"numberOfRuns": 3,
			"settings": {
				"formFactor": "mobile",
				"screenEmulation": {
					"mobile": true,
					"width": 412,
					"height": 823,
					"deviceScaleFactor": 1.75
				},
				"throttlingMethod": "simulate"
			}
		},
		"assert": {
			"aggregationMethod": "median",
			"assertions": {
				"categories:performance": ["error", { "minScore": 0.9 }],
				"categories:accessibility": ["error", { "minScore": 1 }],
				"categories:seo": ["error", { "minScore": 1 }],
				"categories:best-practices": ["error", { "minScore": 0.95 }],
				"largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
				"total-blocking-time": ["error", { "maxNumericValue": 200 }],
				"cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
				"server-response-time": ["error", { "maxNumericValue": 400 }],
				"resource-summary:script:size": ["error", { "maxNumericValue": 153600 }],
				"resource-summary:stylesheet:size": ["error", { "maxNumericValue": 30720 }],
				"resource-summary:font:count": ["error", { "maxNumericValue": 3 }],
				"resource-summary:font:size": ["error", { "maxNumericValue": 102400 }]
			}
		},
		"upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
	}
}
